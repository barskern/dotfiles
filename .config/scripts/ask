#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["openai-agents", "rich"]
# ///

import asyncio
import os
import sys
import subprocess

from agents import (
    Agent,
    Runner,
    set_default_openai_api,
    set_default_openai_client,
    set_tracing_disabled,
)
from openai import AsyncOpenAI
from rich.live import Live
from rich.console import Console
from rich.markdown import Markdown


async def ask(agent, console, prompt, history=None):
    messages = list(history) if history is not None else []
    messages.append({"role": "user", "content": prompt})

    response = ""

    result = Runner.run_streamed(agent, input=messages)

    with Live(
        Markdown(""),
        console=console,
        refresh_per_second=10,
        vertical_overflow="visible",
    ) as live:

        async for event in result.stream_events():
            if event.type != "raw_response_event":
                continue

            text = getattr(event.data, "delta", None)
            if text:
                response += text
                live.update(Markdown(response), refresh=True)

    return result.to_input_list()

async def main():
    URL = os.getenv("AIGW_URL", "https://aigw.cern.ch")
    KEY = os.getenv("AIGW_API_KEY") or subprocess.check_output(
        ["pass", "show", "cern/aigw"], text=True
    ).strip()
    MODEL = os.getenv("AIGW_MODEL", "qwen3.8-27b-fp16")

    console = Console()
    client = AsyncOpenAI(
        base_url=URL,
        api_key=KEY,
    )
    set_default_openai_client(client)
    set_default_openai_api("chat_completions")
    set_tracing_disabled(disabled=True)
    agent = Agent(
        name="Assistant",
        model=MODEL,
        # TODO Make these instructions better
        instructions="You are a helpful but concise assistant.",
    )

    # If we are not in an interactive terminal or user provided something
    # through argv, combine stdin and provided args for a one-off prompt
    if not sys.stdin.isatty() or len(sys.argv) > 1:
        prompt_parts = [
            " ".join(sys.argv[1:]),
            sys.stdin.read().strip() if not sys.stdin.isatty() else "",
        ]
        prompt = "\n\n".join(filter(lambda p: len(p) > 0, prompt_parts))
        if len(prompt) == 0:
            return

        await ask(agent, console, prompt)
        return

    console.print(f"[bold]CERN AIGW[/bold] — {MODEL}")
    console.print("Type [bold]/clear[/bold] or [bold]/quit[/bold].\n")

    history = []
    while True:
        try:
            prompt = console.input("[bold]you>[/bold] ")
        except (EOFError, KeyboardInterrupt):
            console.print()
            break

        if prompt in ("/quit", "/exit"):
            break

        if prompt == "/clear":
            history = []
            console.print("[dim]conversation cleared[/dim]\n")
            continue

        if not prompt:
            continue

        console.print("[bold]assistant>[/bold] ")

        try:
            history = await ask(agent, console, prompt, history)
            console.print()
        except Exception as e:
            console.print(f"\n[red]error:[/red] {e}\n")


if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        pass
